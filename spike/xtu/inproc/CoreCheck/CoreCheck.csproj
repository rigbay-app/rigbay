<Project Sdk="Microsoft.NET.Sdk">
  <!-- Loads the XTU spike module through the REAL Rigbay.Core.ModuleLoadContext (unchanged), to see what the host's own
       loading rules do to design A. References no Intel file. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>..\..\out\inproc\corecheck\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\Rigbay.Core\Rigbay.Core.csproj" />
  </ItemGroup>
</Project>
