<Page
    x:Class="Rigbay.Module.Xaml.SamplePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="14" MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="Fan curve (sample, writes nothing)" FontWeight="SemiBold"/>
        <ComboBox x:Name="Mode" Header="Mode" SelectedIndex="0" Width="240">
            <ComboBoxItem Content="Quiet"/>
            <ComboBoxItem Content="Default"/>
            <ComboBoxItem Content="Turbo"/>
        </ComboBox>
        <TextBlock x:Name="Info" TextWrapping="Wrap"/>
    </StackPanel>
</Page>
