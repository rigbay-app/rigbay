{
  "manifestVersion": 1,
  "id": "demo-fan",
  "name": "Fan studio (demo)",
  "version": "0.2.0",
  "author": "Rigbay contributors",
  "description": "Fans and power limit of a pretend laptop. Demo of the confirm, apply, read-back and revert flow. Writes nothing to your machine.",
  "entry": { "assembly": "Rigbay.DemoModules.dll", "type": "Rigbay.DemoModules.FanStudioModule" },
  "hostApi": ">=0.1.2 <0.2",
  "group": "cooling",
  "requires": {
    "admin": true,
    "network": [],
    "registry": ["HKLM\\SOFTWARE\\Demo\\FanStudio (read)"],
    "services": ["DemoFanService (read)"]
  },
  "languages": "lang",
  "homepage": "https://github.com/rigbay-app/rigbay",
  "icon": "icon.svg"
}
