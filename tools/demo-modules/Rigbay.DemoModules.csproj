<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Demo modules for the app shell (task A3): four module entry types in one assembly, copied by tools/build-demo.ps1 into
    one folder per module. They touch NO hardware: "Fan studio" talks to a fake device that lives in memory.
    The assembly references the Windows App SDK only because Fan studio builds one custom control (level 2); the SDK line must be
    the host's (see src/Rigbay.App/Rigbay.App.csproj).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Rigbay.DemoModules</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <WinAppSdkVersion Condition="'$(WinAppSdkVersion)' == ''">1.8.260921001</WinAppSdkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(WinAppSdkVersion)" />
    <ProjectReference Include="..\..\src\Rigbay.Abstractions\Rigbay.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
