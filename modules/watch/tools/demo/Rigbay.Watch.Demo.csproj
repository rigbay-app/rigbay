<Project Sdk="Microsoft.NET.Sdk">

  <!-- A demo publisher for looking at Watch in the real app WITHOUT any real sensor: it publishes two made-up readings that follow a script
       (calm, hot, calm), and only while something asks for them (a page, a subscriber or a background demand), as a module built for host API 0.1.4 should.
       Nothing here touches the machine. Build and lay out: tools\demo\build-demo.ps1 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Rigbay.Watch.Demo</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\Rigbay.Abstractions\Rigbay.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
