module.tunnel.detail.turn-off = Rigbay dừng và gỡ service Windows của tunnel WireGuard này, giống ứng dụng WireGuard. Truy cập từ xa qua tunnel kết thúc.
module.tunnel.effect.page-toggle = Bật hoặc tắt tunnel WireGuard {0} bằng cách khởi động hoặc gỡ service Windows của nó. Truy cập từ xa qua tunnel bắt đầu hoặc kết thúc.
module.tunnel.effect.start = Đổi cách Windows khởi động service của tunnel {0}: tự động khi bật máy, hoặc chỉ khi được yêu cầu.
module.tunnel.effect.autooff = Từ giờ Rigbay tự tắt tunnel {0} sau từng ấy giờ, không hỏi lại.
module.tunnel.hotkey.toggle = Bật hoặc tắt tunnel {0}

