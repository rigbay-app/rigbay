# Remote tunnel: tiếng Việt. Giữ nguyên {0}; có thể đổi thứ tự.
@code = vi
@name = Tiếng Việt

module.tunnel.name = Remote tunnel
module.tunnel.description = Bật và tắt các tunnel WireGuard ngay từ Rigbay (trang, khay hệ thống, phím tắt, dòng lệnh) và hiện trạng thái của chúng.

# --- probe
module.tunnel.probe.no-wireguard = Chưa cài WireGuard cho Windows. Cài từ https://www.wireguard.com/install/ rồi khởi động lại Rigbay.
module.tunnel.probe.not-signed = Có thư mục WireGuard nhưng wireguard.exe hoặc wg.exe không được WireGuard LLC ký, nên Rigbay không chạy chúng. Hãy cài lại WireGuard từ https://www.wireguard.com/install/.

# --- dashboard
module.tunnel.state.none = Chưa có tunnel
module.tunnel.state.line = {0}/{1} đang bật

# --- page
module.tunnel.group.info = Trạng thái
module.tunnel.group.tunnels = Các tunnel
module.tunnel.info.store-unreadable.header = Không đọc được danh sách tunnel của WireGuard
module.tunnel.info.store-unreadable.description = Rigbay không liệt kê được các tunnel trong thư mục của WireGuard. Rigbay phải chạy bằng quyền quản trị và WireGuard phải nằm ở thư mục mặc định.
module.tunnel.info.no-tunnels.header = Chưa có tunnel nào
module.tunnel.info.no-tunnels.description = Thêm tunnel trong ứng dụng WireGuard (Add Tunnel, rồi nhập tệp hoặc tạo tunnel trống). Rigbay chỉ liệt kê tên và không bao giờ đọc cấu hình của tunnel.
module.tunnel.link.wireguard = WireGuard cho Windows
module.tunnel.link.public = Địa chỉ công khai của {0}

module.tunnel.row.on.header = Bật
module.tunnel.row.on.description = Khởi động hoặc gỡ service Windows của tunnel, giống Activate và Deactivate trong ứng dụng WireGuard. Rigbay hỏi trước.
module.tunnel.row.status.header = Trạng thái
module.tunnel.row.problem.header = Sự cố
module.tunnel.row.endpoint.header = Máy chủ
module.tunnel.row.endpoint.description = Địa chỉ tunnel đang nói chuyện, theo báo cáo của WireGuard.
module.tunnel.row.transfer.header = Đã truyền
module.tunnel.row.transfer.description = Số byte nhận và gửi từ lúc bật tunnel.
module.tunnel.row.handshake.header = Handshake gần nhất
module.tunnel.row.handshake.description = Số giây kể từ lần handshake gần nhất với máy chủ. Đã kết nối nghĩa là dưới 3 phút.
module.tunnel.row.rx.header = Đang nhận
module.tunnel.row.tx.header = Đang gửi
module.tunnel.row.start.header = Chạy cùng Windows
module.tunnel.row.start.description = Đặt kiểu khởi động của service tunnel. Chỉ dùng được khi tunnel đang bật: tắt tunnel sẽ gỡ service của nó, như trong ứng dụng WireGuard, và cài đặt này mất theo.
module.tunnel.row.autooff.header = Tự tắt sau (giờ)
module.tunnel.row.autooff.description = Để an toàn: Rigbay tắt tunnel sau từng ấy giờ kể từ lúc bật, không hỏi lại, và báo cho bạn. 0 là không bao giờ.
module.tunnel.row.port.header = Kiểm tra dịch vụ trên máy (cổng)
module.tunnel.row.port.description = Một cổng TCP, ví dụ của ứng dụng điều khiển từ xa. Rigbay cho biết có gì đang lắng nghe cổng đó ở địa chỉ của tunnel hay không. 0 là không kiểm tra.
module.tunnel.row.local.header = Dịch vụ trên máy
module.tunnel.row.public.header = Địa chỉ công khai
module.tunnel.row.public.description = Văn bản tự do cho bạn, ví dụ địa chỉ bạn dùng để kết nối từ bên ngoài. Hiện thành liên kết ở dưới nếu bắt đầu bằng http hoặc https. Chỉ lưu trên máy này.
module.tunnel.row.public.placeholder = Tùy chọn
module.tunnel.row.hotkey.header = Phím tắt
module.tunnel.row.hotkey.description = Bật hoặc tắt tunnel. Rigbay hỏi trước khi thay đổi bất cứ gì.
module.tunnel.validate.whole = Hãy nhập số nguyên.

