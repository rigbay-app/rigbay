# Game scenes: English (the reference). Every key starts with module.<id>.
@code = en
@name = English

module.scenes.name = Game scenes
module.scenes.description = When a game you chose runs, runs other modules' commands you approved once, and puts things back when it ends.

# --- probe
module.scenes.probe.not-windows = Game scenes needs Windows.

# --- the plan the host shows in its question and in notifications ("Let <this> run these steps by itself?")
module.scenes.plan.name = Game scene "{0}"
module.scenes.default-name = Scene {0}

# --- page
module.scenes.group.scenes = Scenes
module.scenes.row.add.header = Add a scene
module.scenes.row.add.description = A new scene is off until you approve it.
module.scenes.button.add = Add
module.scenes.info.how.header = How a scene works
module.scenes.info.how.description = You approve each scene once; it then runs by itself.
module.scenes.info.how.help = A scene is a list of commands of other modules plus the programs that start it. When you switch it on, Rigbay asks one question that lists every step: the command, what it changes and how it is put back. After you approve, the steps run each time one of the programs starts, a notification shows each run, and the steps are put back a few seconds after the last program has ended. Change anything in the scene (a program, a step, an argument) and it asks again. While a scene is on, Rigbay looks at the running programs every 5 seconds.
module.scenes.info.empty.header = No scenes yet
module.scenes.info.empty.description = Add one, choose its program and its steps.
module.scenes.info.attention.header = Needs attention
module.scenes.row.enabled.header = Run when game starts
module.scenes.row.last.header = Last run
module.scenes.row.name.header = Name
module.scenes.row.games.header = Programs
module.scenes.row.games.placeholder = game.exe, other.exe
module.scenes.row.games.help = The file names of the programs that start this scene, separated by commas (game.exe). Case does not matter. A full path (D:\\Games\\game.exe) matches only that file. The scene runs while any of them runs and is put back a few seconds after the last one has ended.
module.scenes.row.pick.header = Add a running program
module.scenes.row.pick.help = Lists the programs that have a window now. Start the game first, then pick it here.
module.scenes.opt.pick-program = Choose a program
module.scenes.row.refresh.header = Look again
module.scenes.button.refresh = Refresh list

