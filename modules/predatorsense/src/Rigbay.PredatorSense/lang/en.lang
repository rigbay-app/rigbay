# PredatorSense module: English (the reference). Every key starts with module.predatorsense.
@code = en
@name = English

# Shown on the enable row (override the manifest text)
module.predatorsense.name = PredatorSense
module.predatorsense.description = Temperatures, fan speeds and the performance mode of an Acer Predator laptop, and the fan mode: Auto or Maximum.

# Probe: why this machine is not supported
module.predatorsense.probe.no-service = The Acer PredatorSense service (PSSvc) is not installed on this machine.
module.predatorsense.probe.no-wmi = The firmware does not offer the Acer gaming interface (root\\WMI, AcerGamingFunction).
module.predatorsense.probe.check-failed = Could not check this machine: {0}

# Page groups
module.predatorsense.group.readings = Readings
module.predatorsense.group.cooling = Cooling and performance
module.predatorsense.group.settings = Settings

# Readings
module.predatorsense.sensor.cpu-temp = CPU temperature
module.predatorsense.sensor.gpu-temp = GPU temperature
module.predatorsense.sensor.system-temp = System temperature
module.predatorsense.sensor.cpu-fan = CPU fan
module.predatorsense.sensor.gpu-fan1 = GPU fan 1
module.predatorsense.sensor.gpu-fan2 = GPU fan 2
module.predatorsense.row.cpu-temp.description = The Acer firmware sensor. It can read about 10 °C above the Windows thermal zone: they are different sensors.
module.predatorsense.sensor.opmode = Performance mode
module.predatorsense.sensor.opmode.description = The laptop's performance mode as a number: 0 Quiet, 1 Default, 2 Render, 3 Edit, 4 Extreme, 5 Turbo.
module.predatorsense.row.model.header = Machine
module.predatorsense.row.model.description = As the firmware reports it
module.predatorsense.model.unknown = Unknown

# Cooling
module.predatorsense.row.opmode.header = Performance mode
module.predatorsense.row.opmode.description = Read from the laptop
module.predatorsense.row.opmodes.header = Modes this laptop offers
module.predatorsense.row.opmodes.description = Read from the laptop
module.predatorsense.info.opmode-note.header = Change it in PredatorSense for now
module.predatorsense.info.opmode-note.description = Rigbay will offer this after a supervised test.
module.predatorsense.opmode.quiet = Quiet
module.predatorsense.opmode.default = Default
module.predatorsense.opmode.render = Render
module.predatorsense.opmode.edit = Edit
module.predatorsense.opmode.extreme = Extreme
module.predatorsense.opmode.turbo = Turbo
module.predatorsense.opmode.unknown = Unknown
module.predatorsense.row.fan-mode.header = Fan mode
module.predatorsense.row.fan-mode.description = Maximum runs all fans at full speed and is loud.
module.predatorsense.fan.auto = Auto
module.predatorsense.fan.max = Maximum
module.predatorsense.fan.not-set = Not set
module.predatorsense.effect.fan-mode = Maximum runs all fans at full speed and is loud. Auto hands the fans back to the laptop's firmware.
module.predatorsense.effect.fan-mode-revert = Puts the fans back to the previous mode: Maximum runs all fans at full speed and is loud, Auto hands them back to the laptop's firmware.
module.predatorsense.row.last-set.header = Last set by Rigbay
module.predatorsense.row.last-set.description = The laptop cannot report its fan mode, and PredatorSense may change it without telling Rigbay.
module.predatorsense.last.none = Nothing yet
module.predatorsense.last.value = {0} at {1}
module.predatorsense.last.unconfirmed = {0} at {1}, not confirmed
module.predatorsense.row.check.header = Speed check
module.predatorsense.row.check.description = Fan speed read for 10 s after a change. A reading, not proof of the mode.
module.predatorsense.check.none = No change made yet
module.predatorsense.check.no-previous = No earlier mode to go back to, so nothing was changed
module.predatorsense.check.watching = Accepted. Watching fan speed...
module.predatorsense.check.rose = {0} sped up: {1} to {2} rpm
module.predatorsense.check.not-rose = No fan sped up within 10 s
module.predatorsense.check.fell = {0} slowed down: {1} to {2} rpm
module.predatorsense.check.not-fell = Fans are still fast after 10 s
module.predatorsense.check.steady = Speeds unchanged, as expected
module.predatorsense.check.moved = {0} changed: {1} to {2} rpm
module.predatorsense.check.unchecked = Accepted. Speeds could not be read
module.predatorsense.check.refused-readings = Not changed: the sensors cannot be read
module.predatorsense.check.refused-busy = Not changed: another change is running
module.predatorsense.check.refused-guard = Not changed: that value is not allowed
module.predatorsense.check.status-refused = Refused by the laptop (status {0})
module.predatorsense.check.no-answer = The laptop did not answer in time

# Settings
module.predatorsense.row.poll.header = Read the sensors every
module.predatorsense.row.poll.description = While this page is open or something shows the readings (the dashboard, a recorder). Otherwise every 10 s. One read takes about 11 ms.
module.predatorsense.row.restore.header = Restore Auto when Rigbay stops
module.predatorsense.row.restore.description = If Rigbay set Maximum, put the fans back to Auto when the module is turned off or Rigbay closes.
module.predatorsense.row.hotkey.header = Fan shortcut
module.predatorsense.row.hotkey.description = Switches between Maximum and Auto, after you confirm. Not set by default.
module.predatorsense.hotkey.toggle-fan = Switch fans between Maximum and Auto

# Dashboard state line
module.predatorsense.state.starting = Reading sensors
module.predatorsense.state.live = Sensors live
module.predatorsense.state.auto = Fans Auto, set by Rigbay
module.predatorsense.state.max = Fans Maximum, set by Rigbay
module.predatorsense.state.max-unconfirmed = Fans Maximum, not confirmed
module.predatorsense.state.unavailable = Readings not available

# Confirmation text
module.predatorsense.detail.change = Fan mode: {0} -> {1}
module.predatorsense.detail.set = Set fan mode to {0}

# Verbs
module.predatorsense.cmd.status = Print the temperatures and fan speeds
module.predatorsense.cmd.fan = Set the fan mode: auto or max (asks for confirmation)
module.predatorsense.cmd.fan-usage = Usage: rigbay predatorsense fan auto|max
module.predatorsense.cmd.not-running = PredatorSense is not running.
module.predatorsense.cmd.no-readings = Not changed: the sensors cannot be read.
module.predatorsense.cmd.not-confirmed = Not confirmed. Nothing was changed.
module.predatorsense.cmd.fan-done = Fan mode set to {0}. {1}
module.predatorsense.status.model = Machine: {0}
module.predatorsense.status.line = {0}: {1}
module.predatorsense.status.not-available = not available
module.predatorsense.status.opmode = Performance mode: {0}
module.predatorsense.status.fan-mode = Fan mode, last set by Rigbay: {0}

# Notifications
module.predatorsense.toast.fan-title = Fan mode
module.predatorsense.toast.fan-set = Fans set to {0}. {1}
module.predatorsense.toast.fan-failed = Not changed. {0}
module.predatorsense.toast.fan-unconfirmed = Not confirmed whether the fans are on {0}. {1}
