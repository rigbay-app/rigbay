module.recorder.tray.start = Bắt đầu ghi
module.recorder.tray.stop = Dừng ghi
module.recorder.hotkey.toggle = Bắt đầu hoặc dừng ghi

# Lệnh: rigbay recorder start | stop | status
module.recorder.cmd.start = Bắt đầu ghi: start [--every S] [--minutes N] [--metrics a,b]
