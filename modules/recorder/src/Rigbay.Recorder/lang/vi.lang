# Module Ghi dữ liệu: tiếng Việt. Mọi khóa bắt đầu bằng module.recorder.
@code = vi
@name = Tiếng Việt

# Hiển thị ở hàng bật/tắt (thay cho văn bản trong manifest)
module.recorder.name = Ghi dữ liệu
module.recorder.description = Ghi mọi số đo mà các mô-đun khác công bố vào một tệp CSV, kèm một tệp bên cạnh mô tả từng cột.

# Trạng thái: dòng trên bảng điều khiển
module.recorder.state.idle = Đang dừng
module.recorder.state.recording-line = Đang ghi {0}

# Số đo riêng của module
module.recorder.metric.rows = Số dòng đã ghi
module.recorder.metric.rows.description = Số dòng lần ghi đang chạy đã ghi vào tệp. Không có số liệu khi không ghi.

# Trang: nút chính là Bắt đầu hoặc Dừng (dòng bên dưới cho biết tệp, thời gian, số dòng và dung lượng, hoặc lần ghi trước kết thúc thế nào)
module.recorder.group.options = Tùy chọn
module.recorder.group.metrics = Số đo cần ghi
module.recorder.group.history = Lịch sử

# Bắt đầu và dừng
module.recorder.row.start.header = Đang dừng
module.recorder.row.start.description = Ghi các số đo đã chọn vào một tệp CSV mới.
module.recorder.row.start.help = Mỗi số đo được chọn bên dưới thành một cột, kèm một tệp .meta.json bên cạnh mô tả từng cột. Không thay đổi gì trên máy.
module.recorder.row.start.button = Bắt đầu ghi
module.recorder.row.stop.header = Đang ghi
