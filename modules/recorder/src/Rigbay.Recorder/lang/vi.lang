module.recorder.row.hotkey.description = Bắt đầu ghi, hoặc dừng lần ghi đang chạy.

# Chọn số đo
module.recorder.row.no-metrics.header = Chưa có số đo nào
module.recorder.row.no-metrics.description = Chưa có mô-đun nào công bố số đo. Hãy bật một mô-đun đọc cảm biến, rồi mở lại trang này.
module.recorder.row.picked.header = Số đo đã chọn
module.recorder.row.picked.help = Tập số đo được chốt khi bắt đầu ghi. Số đo mà mô-đun công bố sau đó chỉ được liệt kê trong .meta.json, không có trong tệp.
module.recorder.row.pick-all.button = Chọn tất cả
module.recorder.row.pick-none.header = Bỏ chọn tất cả
