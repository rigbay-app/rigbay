# Tùy chọn
module.recorder.row.period.header = Khoảng cách giữa các dòng
module.recorder.row.period.help = Hầu hết nguồn làm mới khoảng một lần mỗi giây, nên chu kỳ ngắn hơn chỉ lặp lại giá trị.
module.recorder.period.1 = 1 giây
module.recorder.period.2 = 2 giây
module.recorder.period.5 = 5 giây
module.recorder.period.10 = 10 giây
