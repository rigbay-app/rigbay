module.recorder.duration.120 = 2 giờ
module.recorder.duration.240 = 4 giờ
module.recorder.row.folder.header = Thư mục
# Dấu gạch chéo ngược viết là \\ trong tệp ngôn ngữ (một dấu đơn bị bỏ, D:\Logs sẽ hiện thành D:Logs)
module.recorder.row.folder.placeholder = Documents\\Rigbay\\logs (mặc định)
module.recorder.row.folder-path.header = Đường dẫn thư mục
