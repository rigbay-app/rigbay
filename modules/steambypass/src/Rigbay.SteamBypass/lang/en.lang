# Steam access module: English (the reference). Every key starts with module.steam-bypass.
@code = en
@name = English

# Shown on the enable row (override the manifest text)
module.steam-bypass.name = Steam access
module.steam-bypass.description = Restores access to Steam on networks that block it, through a local proxy, DNS over HTTPS and a PAC file.

# Dashboard line
module.steam-bypass.state.off = Bypass off
module.steam-bypass.state.failed = Could not turn on
module.steam-bypass.state.on = Bypass on · {0} open
module.steam-bypass.state.on-no-downloads = On, no game downloads · {0} open
module.steam-bypass.metric.active = Steam proxy connections
module.steam-bypass.metric.errors = Steam proxy errors

# Page: the switch is the page's main control; the Status group is there only while the bypass is on
module.steam-bypass.group.status = Status
module.steam-bypass.group.test = Troubleshoot
module.steam-bypass.group.settings = Settings

# The switch and what it changes
module.steam-bypass.row.bypass.header = Steam bypass
module.steam-bypass.row.bypass.description = Sends only Steam addresses through a proxy on this PC.
module.steam-bypass.row.bypass.help = While it is on, this Windows account's proxy setting points at Rigbay's local proxy (127.0.0.1). Only Steam addresses go through it, looked up over DNS over HTTPS. Turning it off puts the previous setting back.
module.steam-bypass.effect.bypass = Changes this Windows account's proxy setting. Turning the bypass on sets the automatic proxy script address (AutoConfigURL, current user) to http://127.0.0.1:18081/proxy.pac and starts a local proxy on 127.0.0.1, ports 18081 and 80. Only Steam addresses go through it. Turning it off puts back the value that was there before and stops the proxy.
module.steam-bypass.effect.bypass-revert = Undoes the last change: after "on", the saved Windows proxy value is put back and the proxy stops; after "off", the bypass is turned on again as described above.
module.steam-bypass.detail.turn-on = Steam bypass: Off → On
module.steam-bypass.detail.turn-off = Steam bypass: On → Off
module.steam-bypass.info.port80.header = Game downloads will not work
module.steam-bypass.info.port80.description = Another program uses port 80 on this PC. Browsing Steam works, but Steam's downloader needs 127.0.0.1:80. Close the other program and turn the bypass off and on again.
module.steam-bypass.info.steam-restart.header = Restart Steam
module.steam-bypass.info.steam-restart.description = Steam was opened before the bypass and reads the proxy setting only when it starts. Close Steam completely and open it again.

# What Steam is doing: the switch's live line and the status verb
module.steam-bypass.steam.not-running = Steam is not running
module.steam-bypass.steam.bypass-off = Steam is running without the bypass
module.steam-bypass.steam.starting = Waiting for Steam to connect
module.steam-bypass.steam.using = Steam is using the bypass
module.steam-bypass.steam.needs-restart = Steam was opened before the bypass: restart it

# Status (only while the bypass is on)
module.steam-bypass.row.active.header = Open connections
module.steam-bypass.row.errors.header = Failed connections
module.steam-bypass.row.errors.description = Since Rigbay started
module.steam-bypass.chart.connections = Open connections
module.steam-bypass.row.listening.header = Listening on
module.steam-bypass.listen.off = Not listening
module.steam-bypass.listen.on = 127.0.0.1:{0} (proxy), 127.0.0.1:{1} (downloads)
module.steam-bypass.listen.on-no-downloads = 127.0.0.1:{0} (proxy); port 80 is not available
module.steam-bypass.problem.address-in-use = Port 18081 is already in use. Is the Steam Bypass app running? Close it first.
module.steam-bypass.problem.setting = The Windows proxy setting could not be written: {0}
module.steam-bypass.problem.listen = The proxy could not start: {0}
module.steam-bypass.problem.restore = The Windows proxy setting could not be put back: {0}
module.steam-bypass.problem.unexpected = Something went wrong while changing the bypass: {0}

# Connection test: one row, its live line lists the four checks after a run
module.steam-bypass.row.test.header = Test the connection
module.steam-bypass.row.test.description = Store, Community, static content and game downloads
module.steam-bypass.row.test.help = Asks four Steam addresses. With the bypass on, the requests go through it; with it off, they go straight out, so you see whether your network blocks Steam.
module.steam-bypass.button.test = Run test
module.steam-bypass.check.store.title = Store
module.steam-bypass.check.community.title = Community
module.steam-bypass.check.static.title = Static content
module.steam-bypass.check.downloads.title = Game downloads
module.steam-bypass.check.running = Testing…
module.steam-bypass.check.ok = Reachable · HTTP {0} · {1} ms
module.steam-bypass.check.refused = Connection refused
module.steam-bypass.check.timeout = Timed out
module.steam-bypass.check.dns = DNS failed
module.steam-bypass.check.reset = Blocked (connection reset)
module.steam-bypass.check.other = Failed: {0}
module.steam-bypass.test.passed = All {0} checks passed
module.steam-bypass.test.failed = {0} of {1} checks failed
module.steam-bypass.test.busy = A test is already running
module.steam-bypass.test.line = {0}: {1}

# Settings
module.steam-bypass.row.auto-on.header = Turn on with Rigbay
module.steam-bypass.row.auto-on.help = The bypass turns on by itself every time this module starts, without asking again. Turning the module off or closing Rigbay puts the Windows setting back.
module.steam-bypass.effect.auto-on = From now on, every time this module starts it turns the bypass on by itself, without asking again. That sets this Windows account's proxy script address (AutoConfigURL) to http://127.0.0.1:18081/proxy.pac and starts a local proxy on 127.0.0.1, ports 18081 and 80. Turning the module off or closing Rigbay puts the previous value back.
module.steam-bypass.row.domains.header = Steam domains
module.steam-bypass.row.domains.help = Only these names (and their subdomains) go through the bypass and are looked up over DNS over HTTPS.
module.steam-bypass.domains.value = {0} names, from {1}
module.steam-bypass.domains.built-in = the built-in list

# Messages
module.steam-bypass.toast.title = Steam access
module.steam-bypass.toast.failed = Could not turn the bypass on. {0}
module.steam-bypass.toast.no-downloads = The bypass is on, but port 80 is in use: game downloads will not work.
module.steam-bypass.toast.restore-failed = The Windows proxy setting could not be put back. Try turning the bypass off again.
module.steam-bypass.toast.busy = A change is already in progress. Your last flip of the switch was ignored.

# Command line: rigbay steam-bypass status | on | off | test
module.steam-bypass.cmd.status = Show whether the bypass is on, what it listens on, connections and Steam
module.steam-bypass.cmd.on = Turn the bypass on (asks first: it changes the Windows proxy setting)
module.steam-bypass.cmd.off = Turn the bypass off and put the Windows proxy setting back (asks first)
module.steam-bypass.cmd.test = Run the four connection checks
module.steam-bypass.cmd.not-running = The Steam access module is not running.
module.steam-bypass.cmd.not-confirmed = Not confirmed. Nothing was changed.
module.steam-bypass.cmd.already-on = The bypass is already on.
module.steam-bypass.cmd.already-off = The bypass is already off.
module.steam-bypass.cmd.turned-on = The bypass is on.
module.steam-bypass.cmd.turned-on-no-downloads = The bypass is on, but port 80 is in use: game downloads will not work.
module.steam-bypass.cmd.turned-off = The bypass is off and the Windows proxy setting is back.
module.steam-bypass.cmd.busy = A change is already in progress. Nothing was changed.
module.steam-bypass.cmd.on-usage = Usage: rigbay steam-bypass on
module.steam-bypass.cmd.off-usage = Usage: rigbay steam-bypass off
module.steam-bypass.cmd.test-usage = Usage: rigbay steam-bypass test
module.steam-bypass.status.on-since = Bypass: on since {0}
module.steam-bypass.status.off = Bypass: off
module.steam-bypass.status.listening = Listening: {0}
module.steam-bypass.status.connections = Connections: {0} open, {1} in total, {2} failed, {3} refused
module.steam-bypass.status.steam = Steam: {0}
module.steam-bypass.status.windows = Windows proxy setting: {0}
module.steam-bypass.status.windows-ours = points at the bypass
module.steam-bypass.status.windows-not-ours = not set by the bypass
