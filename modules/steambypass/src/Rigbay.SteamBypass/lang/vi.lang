# Module Steam access: Tiếng Việt. Mọi khóa bắt đầu bằng module.steam-bypass.
@code = vi
@name = Tiếng Việt

# Hiện ở dòng bật/tắt (thay chữ trong manifest)
module.steam-bypass.name = Truy cập Steam
module.steam-bypass.description = Giúp vào được Steam trên mạng bị chặn, qua proxy cục bộ, DNS over HTTPS và file PAC.

# Dòng trạng thái trên Dashboard
module.steam-bypass.state.off = Bypass đang tắt
module.steam-bypass.state.failed = Không bật được
module.steam-bypass.state.on = Bypass đang bật · {0} kết nối
module.steam-bypass.state.on-no-downloads = Đang bật, không tải game được · {0} kết nối
module.steam-bypass.metric.active = Kết nối proxy Steam
module.steam-bypass.metric.errors = Lỗi proxy Steam

# Nhóm trên trang
module.steam-bypass.group.bypass = Bypass
module.steam-bypass.group.status = Trạng thái
module.steam-bypass.group.check = Kiểm tra kết nối
module.steam-bypass.group.settings = Cài đặt

# Công tắc và thứ nó thay đổi
module.steam-bypass.row.bypass.header = Bypass Steam
module.steam-bypass.row.bypass.description = Đưa Steam vượt qua chỗ mạng chặn. Khi bật, nó đổi cài đặt proxy của Windows.
module.steam-bypass.effect.bypass = Đổi cài đặt proxy của tài khoản Windows này. Bật bypass sẽ đặt địa chỉ script proxy tự động (AutoConfigURL, người dùng hiện tại) thành http://127.0.0.1:18081/proxy.pac và mở một proxy cục bộ ở 127.0.0.1, cổng 18081 và 80. Chỉ địa chỉ Steam đi qua nó. Tắt bypass sẽ trả lại giá trị cũ và dừng proxy.
module.steam-bypass.effect.bypass-revert = Hoàn tác lần đổi vừa rồi: sau khi bật, giá trị proxy Windows đã lưu được trả lại và proxy dừng; sau khi tắt, bypass được bật lại như mô tả ở trên.
module.steam-bypass.detail.turn-on = Bypass Steam: Tắt → Bật
module.steam-bypass.detail.turn-off = Bypass Steam: Bật → Tắt
module.steam-bypass.info.port80.header = Không tải game được
module.steam-bypass.info.port80.description = Một chương trình khác đang dùng cổng 80 trên máy này. Vào Steam bằng trình duyệt vẫn được, nhưng trình tải của Steam cần 127.0.0.1:80. Hãy đóng chương trình đó rồi tắt và bật lại bypass.
module.steam-bypass.info.steam-restart.header = Hãy khởi động lại Steam
module.steam-bypass.info.steam-restart.description = Steam được mở trước khi bật bypass và chỉ đọc cài đặt proxy lúc khởi động. Hãy thoát hẳn Steam rồi mở lại.

# Trạng thái
module.steam-bypass.row.listening.header = Đang lắng nghe
module.steam-bypass.row.listening.description = Chỉ trên máy này (127.0.0.1)
module.steam-bypass.row.active.header = Kết nối đang mở
module.steam-bypass.row.active.description = Các kết nối đang đi qua proxy lúc này
module.steam-bypass.row.errors.header = Lỗi
module.steam-bypass.row.errors.description = Số kết nối thất bại từ lúc Rigbay khởi động
module.steam-bypass.row.steam.header = Steam
module.steam-bypass.row.steam.description = Ứng dụng Steam có đang dùng bypass không
module.steam-bypass.row.problem.header = Sự cố gần nhất
module.steam-bypass.row.domains.header = Tên miền Steam
module.steam-bypass.row.domains.description = Chỉ những tên này (và tên miền con) đi qua bypass và được tra bằng DNS over HTTPS
module.steam-bypass.listen.off = Không lắng nghe
module.steam-bypass.listen.on = 127.0.0.1:{0} (proxy), 127.0.0.1:{1} (tải game)
module.steam-bypass.listen.on-no-downloads = 127.0.0.1:{0} (proxy); cổng 80 không dùng được
module.steam-bypass.steam.not-running = Steam chưa chạy
module.steam-bypass.steam.bypass-off = Steam đang chạy; bypass đang tắt
module.steam-bypass.steam.starting = Đang chờ Steam kết nối
module.steam-bypass.steam.using = Steam đang dùng bypass
module.steam-bypass.steam.needs-restart = Steam được mở trước bypass: hãy khởi động lại nó
module.steam-bypass.problem.none = Không có
module.steam-bypass.problem.address-in-use = Cổng 18081 đang bị dùng. Có phải ứng dụng Steam Bypass đang chạy? Hãy đóng nó trước.
module.steam-bypass.problem.setting = Không ghi được cài đặt proxy của Windows: {0}
module.steam-bypass.problem.listen = Proxy không khởi động được: {0}
module.steam-bypass.problem.restore = Không trả lại được cài đặt proxy của Windows: {0}
module.steam-bypass.domains.value = {0} tên, từ {1}
module.steam-bypass.domains.built-in = danh sách có sẵn

# Kiểm tra kết nối
module.steam-bypass.check.store.title = Cửa hàng
module.steam-bypass.check.store.sub = store.steampowered.com
module.steam-bypass.check.community.title = Cộng đồng
module.steam-bypass.check.community.sub = steamcommunity.com
module.steam-bypass.check.static.title = Nội dung tĩnh
module.steam-bypass.check.static.sub = store.cloudflare.steamstatic.com
module.steam-bypass.check.downloads.title = Tải game
module.steam-bypass.check.downloads.sub = máy chủ cache steamcontent.com, qua 127.0.0.1:80
module.steam-bypass.row.test.header = Thử kết nối
module.steam-bypass.row.test.description = Gọi bốn địa chỉ ở trên. Khi bypass tắt, yêu cầu đi thẳng ra ngoài, nên bạn thấy mạng có chặn Steam hay không.
module.steam-bypass.button.test = Chạy thử
module.steam-bypass.check.idle = Chưa thử
module.steam-bypass.check.running = Đang thử…
module.steam-bypass.check.ok = Vào được · HTTP {0} · {1} ms
module.steam-bypass.check.refused = Kết nối bị từ chối
module.steam-bypass.check.timeout = Hết thời gian chờ
module.steam-bypass.check.dns = Tra DNS thất bại
module.steam-bypass.check.reset = Bị chặn (kết nối bị ngắt)
module.steam-bypass.check.other = Thất bại: {0}
module.steam-bypass.test.passed = Cả {0} mục đều đạt
module.steam-bypass.test.failed = {0} trên {1} mục thất bại
module.steam-bypass.test.busy = Đang có một lần thử chạy
module.steam-bypass.test.line = {0}: {1}

# Cài đặt
module.steam-bypass.row.auto-on.header = Bật khi Rigbay khởi động
module.steam-bypass.row.auto-on.description = Bypass tự bật mỗi lần module này khởi động.
module.steam-bypass.effect.auto-on = Từ giờ, mỗi lần module này khởi động nó sẽ tự bật bypass, không hỏi lại. Việc đó đặt địa chỉ script proxy (AutoConfigURL) của tài khoản Windows này thành http://127.0.0.1:18081/proxy.pac và mở proxy cục bộ ở 127.0.0.1, cổng 18081 và 80. Tắt module hoặc đóng Rigbay sẽ trả lại giá trị cũ.

# Thông báo
module.steam-bypass.toast.title = Truy cập Steam
module.steam-bypass.toast.failed = Không bật được bypass. {0}
module.steam-bypass.toast.no-downloads = Bypass đã bật nhưng cổng 80 đang bị dùng: không tải game được.
module.steam-bypass.toast.restore-failed = Không trả lại được cài đặt proxy của Windows. Hãy thử tắt bypass lần nữa.

