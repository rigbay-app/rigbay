module.steam-bypass.cmd.on-usage = Cách dùng: rigbay steam-bypass on
module.steam-bypass.cmd.off-usage = Cách dùng: rigbay steam-bypass off
module.steam-bypass.cmd.test-usage = Cách dùng: rigbay steam-bypass test
module.steam-bypass.status.on-since = Vượt chặn: đang bật từ {0}
module.steam-bypass.status.off = Vượt chặn: đang tắt
module.steam-bypass.status.listening = Đang lắng nghe: {0}
