<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The XTU profiles module (design A of spike C1): in process, .NET 10, talking to the XTU service through Intel's own
    contract assemblies, which are referenced IN PLACE from the Intel install folder and never copied or committed.
    Building needs Intel XTU installed on the build machine (see modules/xtu/README.md). Self-contained on purpose: the only
    project reference is Rigbay.Abstractions, so the folder can move to its own repository (module-xtu) unchanged.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Rigbay.Module.Xtu</RootNamespace>
    <AssemblyName>Rigbay.Module.Xtu</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A new advisory on a package stays visible as a warning but does not stop a local build (docs/xtu/README.md, "Package audit"). -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <XtuDir Condition="'$(XtuDir)' == ''">$(ProgramFiles)\Intel\Intel(R) Extreme Tuning Utility\Drivers</XtuDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- In its own repository, replace this ProjectReference by the Rigbay.Abstractions NuGet package (same in the tests project and the .slnx). -->
    <ProjectReference Include="..\..\..\src\Rigbay.Abstractions\Rigbay.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <PackageReference Include="System.ServiceModel.Primitives" Version="10.0.652802" />
    <PackageReference Include="System.ServiceModel.NetNamedPipe" Version="10.0.652802" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.0" />
    <!-- Transitive packages of the WCF client, pinned to patched versions (10.0.13 or later fixes every advisory reported for them,
         e.g. GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx, GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj, GHSA-r955-8q5j-3h83). The named-pipe
         client does not use them at run time (message signing only), so compile assets only, nothing is copied. When updating, re-run
         the vulnerable-packages listing of dotnet list package (see docs/xtu/README.md, Package audit). -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" ExcludeAssets="runtime" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Intel's contract assemblies: compile references only (Private=false), loaded at run time from the Intel folder
       through the host's probePaths rule (module.json). -->
  <ItemGroup>
    <Reference Include="XtuInterface"><HintPath>$(XtuDir)\XtuInterface.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="XtuCommon"><HintPath>$(XtuDir)\XtuCommon.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="module.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="lang\*.lang" CopyToOutputDirectory="PreserveNewest" LinkBase="lang" />
    <InternalsVisibleTo Include="Rigbay.Module.Xtu.Tests" />
  </ItemGroup>

</Project>
