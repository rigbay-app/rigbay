# --- command line
module.xtu.cmd.status = Show the service state, the active limits and the profiles.
module.xtu.cmd.list = List the profiles and mark the active one.
module.xtu.cmd.apply = Apply a profile by name (asks for confirmation).
module.xtu.cmd.apply-usage = Usage: rigbay xtu apply <profile name>

# --- hotkeys
module.xtu.hotkey.needs-modifier = {0} was not accepted: a profile hotkey needs Ctrl or Alt.
module.xtu.hotkey.xtu-combo = {0} was not accepted: XTU also listens for it and would switch at the same time. Pick another, or turn off Hotkey-Profile Pairing in XTU.

