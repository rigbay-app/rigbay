<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests with no hardware: fakes stand in for the XTU service and for the host services. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rigbay.Module.Xtu\Rigbay.Module.Xtu.csproj" />
    <ProjectReference Include="..\..\..\src\Rigbay.Abstractions\Rigbay.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Rigbay.Module.Xtu\lang\*.lang" Link="lang\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Rigbay.Module.Xtu\module.json" Link="module.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The recording of the real XTU service's wire format (tools/record-wire.ps1); WireContractTests compares the contract copies with it. -->
    <Content Include="wire\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
