<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console front end of Rigbay.Core LangCheck. Usage: see Program.cs -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>rigbay-langcheck</AssemblyName>
    <RootNamespace>Rigbay.LangCheckTool</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rigbay.Core\Rigbay.Core.csproj" />
  </ItemGroup>

</Project>
