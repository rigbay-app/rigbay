<Window
    x:Class="Rigbay.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 48 px title bar: mark, name, search, room for the caption buttons. This strip is the drag region. -->
        <Grid x:Name="TitleBar" Grid.Row="0" Padding="16,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightInsetColumn" Width="140"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- The Rigbay Dock mark, small cut (20 DIP). Normal form: bay in the text colour, block in the Windows accent.
                     Quiet form (accent hue close to a state colour, see BrandMark.cs): bay in slate, block in the text colour.
                     Both are vectors on a 208 unit grid inside a Viewbox, so they stay sharp at 100, 150 and 200 %. -->
                <Grid x:Name="Mark" Width="20" Height="20" VerticalAlignment="Center"
                      AutomationProperties.AccessibilityView="Raw">
                    <Viewbox x:Name="MarkNormal" Width="20" Height="20">
                        <Grid Width="208" Height="208">
                            <Path Data="{StaticResource RbMarkBaySmall}" Fill="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <Path x:Name="MarkBlock" Data="{StaticResource RbMarkBlockSmall}" Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                        </Grid>
                    </Viewbox>
                    <Viewbox x:Name="MarkQuiet" Width="20" Height="20" Visibility="Collapsed">
                        <Grid Width="208" Height="208">
                            <Path Data="{StaticResource RbMarkBaySmall}" Fill="{ThemeResource RbMarkQuietBayBrush}"/>
                            <Path Data="{StaticResource RbMarkBlockSmall}" Fill="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </Grid>
                    </Viewbox>
                </Grid>
                <TextBlock Text="Rigbay" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
            <AutoSuggestBox x:Name="Search" Grid.Column="1" MaxWidth="460" VerticalAlignment="Center"
                            QueryIcon="Find" TextChanged="OnSearchTextChanged" SuggestionChosen="OnSearchChosen"
                            QuerySubmitted="OnSearchSubmitted"/>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Auto" OpenPaneLength="280" CompactModeThresholdWidth="640" ExpandedModeThresholdWidth="1000"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False"
                        SelectionChanged="OnNavChanged" Background="Transparent">
            <!-- The sheet: hairline border, layer fill, rounded at the top corners, content at most 1000 px wide. -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,1,0"
                    CornerRadius="8,8,0,0" Margin="0,0,12,0">
                <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto">
                    <Grid MaxWidth="1000" Padding="36,24,36,28" HorizontalAlignment="Stretch">
                        <ContentPresenter x:Name="PageHost"/>
                    </Grid>
                </ScrollViewer>
            </Border>
        </NavigationView>

        <Border Grid.Row="2" Style="{StaticResource RbHairlineTop}" Padding="16,0">
            <Grid MinHeight="28">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{StaticResource RbSecondaryCaption}" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
</Window>
