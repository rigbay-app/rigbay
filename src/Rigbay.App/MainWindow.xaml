<Window
    x:Class="Rigbay.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 48 px title bar: mark, name, search, room for the caption buttons. This strip is the drag region. -->
        <Grid x:Name="TitleBar" Grid.Row="0" Padding="16,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightInsetColumn" Width="140"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- The Rigbay Dock mark, small cut (20 DIP). Normal form: bay in the text colour, block in the Windows accent.
                     Quiet form (accent hue close to a state colour, see BrandMark.cs): bay in slate, block in the text colour.
                     Both are vectors on a 208 unit grid inside a Viewbox, so they stay sharp at 100, 150 and 200 %. -->
                <Grid x:Name="Mark" Width="20" Height="20" VerticalAlignment="Center"
                      AutomationProperties.AccessibilityView="Raw">
                    <Viewbox x:Name="MarkNormal" Width="20" Height="20">
                        <Grid Width="208" Height="208">
                            <Path Data="{StaticResource RbMarkBaySmall}" Fill="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <Path x:Name="MarkBlock" Data="{StaticResource RbMarkBlockSmall}" Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                        </Grid>
                    </Viewbox>
                    <Viewbox x:Name="MarkQuiet" Width="20" Height="20" Visibility="Collapsed">
                        <Grid Width="208" Height="208">
                            <Path Data="{StaticResource RbMarkBaySmall}" Fill="{ThemeResource RbMarkQuietBayBrush}"/>
                            <Path Data="{StaticResource RbMarkBlockSmall}" Fill="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </Grid>
                    </Viewbox>
                </Grid>
                <TextBlock Text="Rigbay" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
            <AutoSuggestBox x:Name="Search" Grid.Column="1" MaxWidth="460" VerticalAlignment="Center" UpdateTextOnSelect="False"
                            QueryIcon="Find" TextChanged="OnSearchTextChanged" SuggestionChosen="OnSearchChosen"
                            QuerySubmitted="OnSearchSubmitted"/>
        </Grid>

        <!-- The pane: labels from 1000 px, an icon rail below that (480 rather than 500, so the rail is still there at the minimum width
             once the window frame is taken off), and below that only the menu button. The menu button is always
             there, so Modules, Settings and Log can be reached at every width (a window snapped to half of a 1280 px screen is 640 px).
             The window cannot be made narrower than 500 px (MainWindow.ApplyMinimumSize). -->
        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Auto" OpenPaneLength="280" CompactModeThresholdWidth="480" ExpandedModeThresholdWidth="1000"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="True"
                        SelectionChanged="OnNavChanged" Background="Transparent">
            <!-- The sheet: hairline border, layer fill, rounded at the top corners, content at most 1000 px wide. -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,1,0"
                    CornerRadius="8,8,0,0" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Messages above the page, in their own row: they push the page down while open and never cover its header.
                         AdminBar: only when Rigbay is not elevated. NoticeBar: the result of a change the user just made on a page
                         (docs/APP.md, Notifications); it closes by itself, failures stay longer. -->
                    <StackPanel Grid.Row="0" MaxWidth="1000" Padding="36,0,36,0" HorizontalAlignment="Stretch">
                        <InfoBar x:Name="AdminBar" IsOpen="False" IsClosable="False" Severity="Warning" Margin="0,12,0,0"/>
                        <InfoBar x:Name="NoticeBar" IsOpen="False" IsClosable="True" Margin="0,12,0,0"/>
                    </StackPanel>
                    <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid MaxWidth="1000" Padding="36,24,36,28" HorizontalAlignment="Stretch">
                            <ContentPresenter x:Name="PageHost"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </NavigationView>
    </Grid>
</Window>
