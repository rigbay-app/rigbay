<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Rigbay.App</AssemblyName>
    <RootNamespace>Rigbay.App</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\rigbay.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- We own Main(): the process decides before any XAML starts whether this is a command-line verb or the UI. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Framework-dependent against the installed Windows App Runtime is the main path (build.ps1 -SelfContained is the other, see docs/APP.md). -->
    <WindowsAppSDKSelfContained Condition="'$(WindowsAppSDKSelfContained)' == ''">false</WindowsAppSDKSelfContained>
    <!--
      Windows App SDK line, pinned here (the root Directory.Build.props belongs to task A2).
      1.8.260921001 is the line the spike (docs/spike/SPIKE.md) ran as its main line: installed runtime 1.8 = 8000.994.2142.0,
      first frame about 570 ms, the toolkit SettingsControls package, unpackaged + elevated + modules all passed.
      2.6.4 also ran but its very first start took 2.4 to 3.6 s and nothing in the shell needs it. A module with a custom
      control binds to this exact line, so a change of line is a host API decision, not a routine update.
      Override for a trial with -p:WinAppSdkVersion=2.6.4.
    -->
    <WinAppSdkVersion Condition="'$(WinAppSdkVersion)' == ''">1.8.260921001</WinAppSdkVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- version resource of the exe: product and file description, and a plain "0.1.0" (no +commit suffix) so a release build is the same bytes from any clone -->
    <Product>Rigbay</Product>
    <AssemblyTitle>Rigbay</AssemblyTitle>
    <Description>Rigbay: a small Windows app that manages modules for your own machine</Description>
    <Company>Rigbay contributors</Company>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(WinAppSdkVersion)" />
    <!-- Rows are SettingsCard / SettingsExpander. 8.2.251219 is the version the spike tested. -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <ProjectReference Include="..\Rigbay.Abstractions\Rigbay.Abstractions.csproj" />
    <ProjectReference Include="..\Rigbay.Core\Rigbay.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- host strings: embedded (the core loads them) and copied next to the exe so the langcheck switch can read the files -->
    <EmbeddedResource Include="lang\*.lang" LogicalName="Rigbay.App.lang.%(Filename)%(Extension)" />
    <Content Include="lang\*.lang" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- app icon, tray pair, high-contrast pair and the neutral module icon: copies of assets\brand, listed in Assets\brand-files.txt -->
    <Content Include="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\modules\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
