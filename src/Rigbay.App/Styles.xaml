<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Rigbay's own resources: reading hues (one family per kind of reading), and a few styles that follow the theme.
      State colours (ok / warning / error) are the system's SystemFillColor*Brush, so they match Windows in dark, light and high contrast.
      Brushes are looked up with ThemeResource inside styles; looking them up from code returns the APP theme, not the window's.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="RbReadingTemperatureBrush" Color="#A84300"/>
            <SolidColorBrush x:Key="RbReadingPowerBrush" Color="#0B5CAD"/>
            <SolidColorBrush x:Key="RbReadingSpeedBrush" Color="#00695C"/>
            <SolidColorBrush x:Key="RbReadingLoadBrush" Color="#6E5600"/>
            <SolidColorBrush x:Key="RbMarkQuietBayBrush" Color="#7B8497"/>
            <SolidColorBrush x:Key="RbSeries1Brush" Color="#2a78d6"/>
            <SolidColorBrush x:Key="RbSeries2Brush" Color="#eb6834"/>
            <SolidColorBrush x:Key="RbSeries3Brush" Color="#1baf7a"/>
            <SolidColorBrush x:Key="RbSeries4Brush" Color="#eda100"/>
            <SolidColorBrush x:Key="RbSeries5Brush" Color="#e87ba4"/>
            <SolidColorBrush x:Key="RbSeries6Brush" Color="#008300"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="RbReadingTemperatureBrush" Color="#FFA66B"/>
            <SolidColorBrush x:Key="RbReadingPowerBrush" Color="#6CB8FF"/>
            <SolidColorBrush x:Key="RbReadingSpeedBrush" Color="#5FD3C4"/>
            <SolidColorBrush x:Key="RbReadingLoadBrush" Color="#E5C95C"/>
            <SolidColorBrush x:Key="RbMarkQuietBayBrush" Color="#7B8497"/>
            <SolidColorBrush x:Key="RbSeries1Brush" Color="#3987e5"/>
            <SolidColorBrush x:Key="RbSeries2Brush" Color="#d95926"/>
            <SolidColorBrush x:Key="RbSeries3Brush" Color="#199e70"/>
            <SolidColorBrush x:Key="RbSeries4Brush" Color="#c98500"/>
            <SolidColorBrush x:Key="RbSeries5Brush" Color="#d55181"/>
            <SolidColorBrush x:Key="RbSeries6Brush" Color="#008300"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="RbReadingTemperatureBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="RbReadingPowerBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="RbReadingSpeedBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="RbReadingLoadBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="RbMarkQuietBayBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="RbSeries1Brush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="RbSeries2Brush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="RbSeries3Brush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="RbSeries4Brush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="RbSeries5Brush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="RbSeries6Brush" Color="{ThemeResource SystemColorWindowTextColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="RbSecondaryText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Style>
    <Style x:Key="RbSecondaryCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Style>
    <Style x:Key="RbPrimaryText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
    </Style>
    <Style x:Key="RbErrorText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}"/>
    </Style>
    <Style x:Key="RbOkText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}"/>
    </Style>
    <Style x:Key="RbGroupHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Margin" Value="1,16,0,6"/>
    </Style>

    <Style x:Key="RbReadingTemperature" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource RbReadingTemperatureBrush}"/></Style>
    <Style x:Key="RbReadingPower" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource RbReadingPowerBrush}"/></Style>
    <Style x:Key="RbReadingSpeed" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource RbReadingSpeedBrush}"/></Style>
    <Style x:Key="RbReadingLoad" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource RbReadingLoadBrush}"/></Style>

    <!-- The bay mark: a 5 px bar. Filled green = ready, filled red = failed, filled amber = needs attention, outline = off / unsupported / empty. -->
    <Style x:Key="RbBayReady" TargetType="Rectangle">
        <Setter Property="Width" Value="5"/><Setter Property="RadiusX" Value="1"/><Setter Property="RadiusY" Value="1"/>
        <Setter Property="Fill" Value="{ThemeResource SystemFillColorSuccessBrush}"/>
    </Style>
    <Style x:Key="RbBayFailed" TargetType="Rectangle">
        <Setter Property="Width" Value="5"/><Setter Property="RadiusX" Value="1"/><Setter Property="RadiusY" Value="1"/>
        <Setter Property="Fill" Value="{ThemeResource SystemFillColorCriticalBrush}"/>
    </Style>
    <Style x:Key="RbBayAttention" TargetType="Rectangle">
        <Setter Property="Width" Value="5"/><Setter Property="RadiusX" Value="1"/><Setter Property="RadiusY" Value="1"/>
        <Setter Property="Fill" Value="{ThemeResource SystemFillColorCautionBrush}"/>
    </Style>
    <Style x:Key="RbBayOutline" TargetType="Rectangle">
        <Setter Property="Width" Value="5"/><Setter Property="RadiusX" Value="1"/><Setter Property="RadiusY" Value="1"/>
        <Setter Property="Stroke" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
    </Style>

    <Style x:Key="RbHairlineBottom" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style x:Key="RbHairlineTop" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>

    <!--
      Reading visuals (sparklines, tiles, trend charts). One style per hue and shape, because a brush fetched from code would follow the app theme and
      not the window's; a style resolves it in the element's own tree. Hues: one family per kind of reading (Temperature, Power, Speed, Load), Neutral,
      and S1..S6 for the series of a chart with more than one line (the documented categorical order, validated with the data-viz script).
    -->
    <Style x:Key="RbLineTemperature" TargetType="Polyline"><Setter Property="Stroke" Value="{ThemeResource RbReadingTemperatureBrush}"/><Setter Property="StrokeThickness" Value="2"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/></Style>
    <Style x:Key="RbFillTemperature" TargetType="Path"><Setter Property="Fill" Value="{ThemeResource RbReadingTemperatureBrush}"/><Setter Property="Opacity" Value="0.12"/></Style>
    <Style x:Key="RbDotTemperature" TargetType="Ellipse"><Setter Property="Fill" Value="{ThemeResource RbReadingTemperatureBrush}"/><Setter Property="Stroke" Value="{ThemeResource ControlSolidFillColorDefaultBrush}"/><Setter Property="StrokeThickness" Value="2"/></Style>
    <Style x:Key="RbKeyTemperature" TargetType="Rectangle"><Setter Property="Fill" Value="{ThemeResource RbReadingTemperatureBrush}"/><Setter Property="RadiusX" Value="1"/><Setter Property="RadiusY" Value="1"/></Style>
    <Style x:Key="RbLinePower" TargetType="Polyline"><Setter Property="Stroke" Value="{ThemeResource RbReadingPowerBrush}"/><Setter Property="StrokeThickness" Value="2"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/></Style>
    <Style x:Key="RbFillPower" TargetType="Path"><Setter Property="Fill" Value="{ThemeResource RbReadingPowerBrush}"/><Setter Property="Opacity" Value="0.12"/></Style>
    <Style x:Key="RbDotPower" TargetType="Ellipse"><Setter Property="Fill" Value="{ThemeResource RbReadingPowerBrush}"/><Setter Property="Stroke" Value="{ThemeResource ControlSolidFillColorDefaultBrush}"/><Setter Property="StrokeThickness" Value="2"/></Style>
    <Style x:Key="RbKeyPower" TargetType="Rectangle"><Setter Property="Fill" Value="{ThemeResource RbReadingPowerBrush}"/><Setter Property="RadiusX" Value="1"/><Setter Property="RadiusY" Value="1"/></Style>
    <Style x:Key="RbLineSpeed" TargetType="Polyline"><Setter Property="Stroke" Value="{ThemeResource RbReadingSpeedBrush}"/><Setter Property="StrokeThickness" Value="2"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/></Style>
    <Style x:Key="RbFillSpeed" TargetType="Path"><Setter Property="Fill" Value="{ThemeResource RbReadingSpeedBrush}"/><Setter Property="Opacity" Value="0.12"/></Style>
    <Style x:Key="RbDotSpeed" TargetType="Ellipse"><Setter Property="Fill" Value="{ThemeResource RbReadingSpeedBrush}"/><Setter Property="Stroke" Value="{ThemeResource ControlSolidFillColorDefaultBrush}"/><Setter Property="StrokeThickness" Value="2"/></Style>
    <Style x:Key="RbKeySpeed" TargetType="Rectangle"><Setter Property="Fill" Value="{ThemeResource RbReadingSpeedBrush}"/><Setter Property="RadiusX" Value="1"/><Setter Property="RadiusY" Value="1"/></Style>
    <Style x:Key="RbLineLoad" TargetType="Polyline"><Setter Property="Stroke" Value="{ThemeResource RbReadingLoadBrush}"/><Setter Property="StrokeThickness" Value="2"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/></Style>
    <Style x:Key="RbFillLoad" TargetType="Path"><Setter Property="Fill" Value="{ThemeResource RbReadingLoadBrush}"/><Setter Property="Opacity" Value="0.12"/></Style>
    <Style x:Key="RbDotLoad" TargetType="Ellipse"><Setter Property="Fill" Value="{ThemeResource RbReadingLoadBrush}"/><Setter Property="Stroke" Value="{ThemeResource ControlSolidFillColorDefaultBrush}"/><Setter Property="StrokeThickness" Value="2"/></Style>
    <Style x:Key="RbKeyLoad" TargetType="Rectangle"><Setter Property="Fill" Value="{ThemeResource RbReadingLoadBrush}"/><Setter Property="RadiusX" Value="1"/><Setter Property="RadiusY" Value="1"/></Style>
    <Style x:Key="RbLineNeutral" TargetType="Polyline"><Setter Property="Stroke" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Property="StrokeThickness" Value="2"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/></Style>
    <Style x:Key="RbFillNeutral" TargetType="Path"><Setter Property="Fill" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Property="Opacity" Value="0.12"/></Style>
    <Style x:Key="RbDotNeutral" TargetType="Ellipse"><Setter Property="Fill" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Property="Stroke" Value="{ThemeResource ControlSolidFillColorDefaultBrush}"/><Setter Property="StrokeThickness" Value="2"/></Style>
    <Style x:Key="RbKeyNeutral" TargetType="Rectangle"><Setter Property="Fill" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Property="RadiusX" Value="1"/><Setter Property="RadiusY" Value="1"/></Style>
    <Style x:Key="RbLineS1" TargetType="Polyline"><Setter Property="Stroke" Value="{ThemeResource RbSeries1Brush}"/><Setter Property="StrokeThickness" Value="2"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/></Style>
    <Style x:Key="RbFillS1" TargetType="Path"><Setter Property="Fill" Value="{ThemeResource RbSeries1Brush}"/><Setter Property="Opacity" Value="0.12"/></Style>
    <Style x:Key="RbDotS1" TargetType="Ellipse"><Setter Property="Fill" Value="{ThemeResource RbSeries1Brush}"/><Setter Property="Stroke" Value="{ThemeResource ControlSolidFillColorDefaultBrush}"/><Setter Property="StrokeThickness" Value="2"/></Style>
    <Style x:Key="RbKeyS1" TargetType="Rectangle"><Setter Property="Fill" Value="{ThemeResource RbSeries1Brush}"/><Setter Property="RadiusX" Value="1"/><Setter Property="RadiusY" Value="1"/></Style>
    <Style x:Key="RbLineS2" TargetType="Polyline"><Setter Property="Stroke" Value="{ThemeResource RbSeries2Brush}"/><Setter Property="StrokeThickness" Value="2"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/></Style>
    <Style x:Key="RbFillS2" TargetType="Path"><Setter Property="Fill" Value="{ThemeResource RbSeries2Brush}"/><Setter Property="Opacity" Value="0.12"/></Style>
    <Style x:Key="RbDotS2" TargetType="Ellipse"><Setter Property="Fill" Value="{ThemeResource RbSeries2Brush}"/><Setter Property="Stroke" Value="{ThemeResource ControlSolidFillColorDefaultBrush}"/><Setter Property="StrokeThickness" Value="2"/></Style>
    <Style x:Key="RbKeyS2" TargetType="Rectangle"><Setter Property="Fill" Value="{ThemeResource RbSeries2Brush}"/><Setter Property="RadiusX" Value="1"/><Setter Property="RadiusY" Value="1"/></Style>
    <Style x:Key="RbLineS3" TargetType="Polyline"><Setter Property="Stroke" Value="{ThemeResource RbSeries3Brush}"/><Setter Property="StrokeThickness" Value="2"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/></Style>
    <Style x:Key="RbFillS3" TargetType="Path"><Setter Property="Fill" Value="{ThemeResource RbSeries3Brush}"/><Setter Property="Opacity" Value="0.12"/></Style>
    <Style x:Key="RbDotS3" TargetType="Ellipse"><Setter Property="Fill" Value="{ThemeResource RbSeries3Brush}"/><Setter Property="Stroke" Value="{ThemeResource ControlSolidFillColorDefaultBrush}"/><Setter Property="StrokeThickness" Value="2"/></Style>
    <Style x:Key="RbKeyS3" TargetType="Rectangle"><Setter Property="Fill" Value="{ThemeResource RbSeries3Brush}"/><Setter Property="RadiusX" Value="1"/><Setter Property="RadiusY" Value="1"/></Style>
    <Style x:Key="RbLineS4" TargetType="Polyline"><Setter Property="Stroke" Value="{ThemeResource RbSeries4Brush}"/><Setter Property="StrokeThickness" Value="2"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/></Style>
    <Style x:Key="RbFillS4" TargetType="Path"><Setter Property="Fill" Value="{ThemeResource RbSeries4Brush}"/><Setter Property="Opacity" Value="0.12"/></Style>
    <Style x:Key="RbDotS4" TargetType="Ellipse"><Setter Property="Fill" Value="{ThemeResource RbSeries4Brush}"/><Setter Property="Stroke" Value="{ThemeResource ControlSolidFillColorDefaultBrush}"/><Setter Property="StrokeThickness" Value="2"/></Style>
    <Style x:Key="RbKeyS4" TargetType="Rectangle"><Setter Property="Fill" Value="{ThemeResource RbSeries4Brush}"/><Setter Property="RadiusX" Value="1"/><Setter Property="RadiusY" Value="1"/></Style>
    <Style x:Key="RbLineS5" TargetType="Polyline"><Setter Property="Stroke" Value="{ThemeResource RbSeries5Brush}"/><Setter Property="StrokeThickness" Value="2"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/></Style>
    <Style x:Key="RbFillS5" TargetType="Path"><Setter Property="Fill" Value="{ThemeResource RbSeries5Brush}"/><Setter Property="Opacity" Value="0.12"/></Style>
    <Style x:Key="RbDotS5" TargetType="Ellipse"><Setter Property="Fill" Value="{ThemeResource RbSeries5Brush}"/><Setter Property="Stroke" Value="{ThemeResource ControlSolidFillColorDefaultBrush}"/><Setter Property="StrokeThickness" Value="2"/></Style>
    <Style x:Key="RbKeyS5" TargetType="Rectangle"><Setter Property="Fill" Value="{ThemeResource RbSeries5Brush}"/><Setter Property="RadiusX" Value="1"/><Setter Property="RadiusY" Value="1"/></Style>
    <Style x:Key="RbLineS6" TargetType="Polyline"><Setter Property="Stroke" Value="{ThemeResource RbSeries6Brush}"/><Setter Property="StrokeThickness" Value="2"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/></Style>
    <Style x:Key="RbFillS6" TargetType="Path"><Setter Property="Fill" Value="{ThemeResource RbSeries6Brush}"/><Setter Property="Opacity" Value="0.12"/></Style>
    <Style x:Key="RbDotS6" TargetType="Ellipse"><Setter Property="Fill" Value="{ThemeResource RbSeries6Brush}"/><Setter Property="Stroke" Value="{ThemeResource ControlSolidFillColorDefaultBrush}"/><Setter Property="StrokeThickness" Value="2"/></Style>
    <Style x:Key="RbKeyS6" TargetType="Rectangle"><Setter Property="Fill" Value="{ThemeResource RbSeries6Brush}"/><Setter Property="RadiusX" Value="1"/><Setter Property="RadiusY" Value="1"/></Style>

    <Style x:Key="RbChartGrid" TargetType="Line"><Setter Property="Stroke" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/><Setter Property="StrokeThickness" Value="1"/></Style>
    <Style x:Key="RbChartCursor" TargetType="Line"><Setter Property="Stroke" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Property="StrokeThickness" Value="1"/></Style>
    <Style x:Key="RbMeterTrack" TargetType="Rectangle"><Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/><Setter Property="RadiusX" Value="1.5"/><Setter Property="RadiusY" Value="1.5"/></Style>
    <Style x:Key="RbChartTip" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlSolidFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,6,8,6"/>
    </Style>
    <Style x:Key="RbTileFrame" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <!-- the selected tile (the chart draws its reading): a 1.5 px accent border over a faint accent tint; hover is a subtle fill -->
    <Style x:Key="RbTileFrameSelected" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style x:Key="RbTileHover" TargetType="Border"><Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/></Style>
    <Style x:Key="RbTileTint" TargetType="Border"><Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/></Style>
    <!-- the state dot of the module page's header card; the state is also a word beside it -->
    <Style x:Key="RbStateDotReady" TargetType="Ellipse"><Setter Property="Fill" Value="{ThemeResource SystemFillColorSuccessBrush}"/></Style>
    <Style x:Key="RbStateDotFailed" TargetType="Ellipse"><Setter Property="Fill" Value="{ThemeResource SystemFillColorCriticalBrush}"/></Style>
    <Style x:Key="RbStateDotAttention" TargetType="Ellipse"><Setter Property="Fill" Value="{ThemeResource SystemFillColorCautionBrush}"/></Style>
    <Style x:Key="RbStateDotOutline" TargetType="Ellipse"><Setter Property="Stroke" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}"/><Setter Property="StrokeThickness" Value="1.5"/></Style>
    <Style x:Key="RbTileValue" TargetType="TextBlock" BasedOn="{StaticResource TitleLargeTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
    </Style>
    <!-- a limit or a target in a chart (ReadingRow.ChartRole = Reference): 1 px in secondary ink, dashed 4/3 (set in code: a dash array in a style setter is ignored) -->
    <Style x:Key="RbChartReference" TargetType="Polyline">
        <Setter Property="Stroke" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="StrokeThickness" Value="1"/>
    </Style>
    <!-- the warning value on a tile meter (ReadingRow.Warn): a 1 px tick across the track -->
    <Style x:Key="RbMeterTick" TargetType="Rectangle"><Setter Property="Fill" Value="{ThemeResource TextFillColorSecondaryBrush}"/></Style>

    <!--
      The module page's main control (PageModel.Primary): its card, its header, and the segmented control a short choice becomes. The segmented
      control is the stock RadioButtons (one tab stop, arrow keys, "2 of 3" for a screen reader) with each RadioButton drawn as a segment:
      a recessed track, the selected segment raised with a short accent bar under its label.
    -->
    <Style x:Key="RbHeroCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}"/>
        <Setter Property="Padding" Value="16,14,16,16"/>
    </Style>
    <Style x:Key="RbPrimaryHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="RbPrimaryHeaderDisabled" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorDisabledBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="RbSegmentTrack" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlAltFillColorSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
    </Style>
    <Style x:Key="RbSegment" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="12,0,12,1"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="FocusVisualMargin" Value="-1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters><Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters><Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}"/>
                                        <Setter Target="Bar.Fill" Value="{ThemeResource AccentFillColorDisabledBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Raised.Opacity" Value="1"/>
                                        <Setter Target="Bar.Opacity" Value="1"/>
                                        <Setter Target="Label.FontWeight" Value="SemiBold"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked"/>
                                <VisualState x:Name="Indeterminate"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Raised" Opacity="0" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}"/>
                        <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}"
                                          Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextWrapping="NoWrap" FontSize="{TemplateBinding FontSize}"/>
                        <Rectangle x:Name="Bar" Opacity="0" Width="16" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="0,0,0,3" VerticalAlignment="Bottom" HorizontalAlignment="Center" Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RbSegmentLarge" TargetType="RadioButton" BasedOn="{StaticResource RbSegment}">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Padding" Value="14,0,14,2"/>
    </Style>

</ResourceDictionary>
